{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-sos-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-07",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets are NOT stored in this file. Set them as Cloudflare secrets:
  //   npx wrangler secret put PRISMA_ACCELERATE_URL
  //   npx wrangler secret put JWT_SECRET
  // For local development, copy .env.example to .env (git-ignored).
