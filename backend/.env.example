# Copy to backend/.env for local development. Never commit real values.
# Read by `wrangler dev` (Worker runtime) and by the Prisma CLI (prisma.config.ts).
# In production these are Cloudflare secrets: `npx wrangler secret put <NAME>`.

# Prisma Accelerate connection string used by the Worker at runtime.
PRISMA_ACCELERATE_URL="<your-prisma-accelerate-connection-string>"

# Postgres connection string used by the Prisma CLI for migrations (local only, not a Worker secret).
DATABASE_URL="<your-postgres-connection-string>"

# HMAC key for signing JWTs. Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="<at-least-32-random-characters>"
