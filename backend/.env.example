# Copy to backend/.env for local development. Never commit real values.
# Read by `wrangler dev` (Worker runtime) and by the Prisma CLI (prisma.config.ts).
# In production only DATABASE_URL and JWT_SECRET are needed, as encrypted Cloudflare
# secrets: `npx wrangler secret put <NAME>`. Never put them in wrangler.jsonc "vars".

# Neon POOLED connection string (hostname contains "-pooler"), used by the Worker
# through @prisma/adapter-neon.
DATABASE_URL="<your-neon-pooled-connection-string>"

# Neon DIRECT (non-pooled) connection string, used only by the Prisma CLI for
# migrations. Keep it local; it is not a Worker secret.
DIRECT_URL="<your-neon-direct-connection-string>"

# HMAC key for signing JWTs. Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="<at-least-32-random-characters>"
